{
  "dependencies": {
    "next": "^15.3.0",
    "nextra": "^4.2.17",
    "nextra-theme-docs": "^4.2.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "dev": "next",
    "build": "wireit",
    "start": "next start"
  },
  "wireit": {
    "_build": {
      "command": "next build"
    },
    "_pagefind": {
      "dependencies": [
        "_build"
      ],
      "command": "npx pagefind --site .next/server/app --output-path public/_pagefind"
    },
    "_copy": {
      "dependencies": [
        "_pagefind"
      ],
      "command": "cp -r public .next/standalone && cp -r .next/static .next/standalone/.next/"
    },
    "build": {
      "dependencies": [
        "_build",
        "_pagefind",
        "_copy"
      ]
    }
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "wireit": "^0.14.12"
  }
}
